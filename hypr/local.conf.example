# ============================================================
# Configuración local (dependiente del equipo)
# Copia este archivo como local.conf y adáptalo a tu equipo
# ============================================================


# ── Monitores ────────────────────────────────────────────────
# Formato: monitor=nombre, resolución@refresco, posición, escala
# Ejemplos:
#   monitor=LVDS-1,1366x768@60,0x0,1
#   monitor=HDMI-A-1,1920x1080@60,1366x0,1
#   monitor=,preferred,auto,auto  (auto-detectar)

monitor=,preferred,auto,auto


# ── Teclado ──────────────────────────────────────────────────
# https://wiki.hypr.land/Configuring/Variables/#input

input {
    kb_layout = us
    kb_variant = altgr-intl
    kb_model =
    kb_options =
    kb_rules =
}


# ── Workspaces por monitor (opcional) ───────────────────────
# Asigna workspaces a monitores específicos
# Ejemplo:
#   workspace = 1, monitor:LVDS-1, default:true
#   workspace = 6, monitor:HDMI-A-1, default:true


# ── Dispositivos de entrada específicos (opcional) ──────────
# Ejemplo:
#   device {
#       name = epic-mouse-v1
#       sensitivity = -0.5
#   }
