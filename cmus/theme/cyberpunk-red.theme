# Cyberpunk Red — cmus theme
# Based on the system design guide palette

# ─── Window base ─────────────────────────────────────────
set color_win_fg=217
set color_win_bg=0

# ─── Window title bar (top) ──────────────────────────────
set color_win_title_fg=51
set color_win_title_bg=233

# ─── Currently playing ───────────────────────────────────
set color_win_cur=226
set color_win_cur_sel_bg=196
set color_win_cur_sel_fg=0
set color_win_inactive_cur_sel_bg=233
set color_win_inactive_cur_sel_fg=226

# ─── Selection ───────────────────────────────────────────
set color_win_sel_bg=52
set color_win_sel_fg=196
set color_win_inactive_sel_bg=233
set color_win_inactive_sel_fg=88

# ─── Directory colors ────────────────────────────────────
set color_win_dir=51

# ─── Command line ────────────────────────────────────────
set color_cmdline_fg=226
set color_cmdline_bg=0

# ─── Messages ────────────────────────────────────────────
set color_error=196
set color_info=51
set color_separator=88

# ─── Status line (bottom) ────────────────────────────────
set color_statusline_fg=31
set color_statusline_bg=234
set color_statusline_progress_bg=52
set color_statusline_progress_fg=196

# ─── Title line ──────────────────────────────────────────
set color_titleline_fg=31
set color_titleline_bg=234
